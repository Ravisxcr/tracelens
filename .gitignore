# ==========================================
# TraceLens Comprehensive .gitignore
# ==========================================

# ------------------------------------------
# Go / Backend Build & Binaries
# ------------------------------------------
bin/
backend/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Go test coverage and profiles
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace & vendor
vendor/
go.work
go.work.sum

# ------------------------------------------
# Node.js / React Frontend
# ------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/
backend/internal/web/dist/assets/

# NPM / Yarn / PNPM logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Environment & Local Secrets
# ------------------------------------------
.env
.env.local
.env.*.local
*.env

# ------------------------------------------
# IDE & Editor Configuration
# ------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------
# Temporary / Scratch Dirs & Local Go Cache
# ------------------------------------------
tmp/
scratch/
.go/
